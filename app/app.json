{
  "expo": {
    "scheme": "palmsetu",
    "name": "Palm Setu",
    "slug": "palm-setu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.palmsetuapp.android",
      "adaptiveIcon": {
        "backgroundColor": "#430194",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#161826"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "owner": "samthugger7",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "438b283d-07a0-41cf-83b2-bba8a4bbd44b"
      }
    }
  }
}
