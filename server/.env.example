PORT=4000
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Auth - JWT signing secret for access/guest session tokens. Generate a real
# random value for any non-local environment (e.g. `openssl rand -hex 32`).
# Falls back to an insecure dev default if unset, logged loudly on boot.
JWT_SECRET=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) -
# used to protect signup/login instead of email OTP. Get both keys from the
# same Turnstile widget. Without a secret key configured, server-side
# verification is skipped and a warning is logged - fine for local dev, not
# safe for production (see auth/turnstile.ts).
TURNSTILE_SECRET_KEY=
# Public site key, read by the app via EXPO_PUBLIC_TURNSTILE_SITE_KEY - keep
# both in sync when rotating.

# Razorpay (https://dashboard.razorpay.com/) - real payment gateway for the
# Soulmate Sketch feature. Without these, order creation fails with a clear
# PAYMENT_NOT_CONFIGURED error (never a fake successful payment). See
# payments/razorpay.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret from the dashboard's Webhooks section, used only to verify
# the x-razorpay-signature header on POST /soulmate/webhook - not the same
# value as RAZORPAY_KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=

# SMTP (plain, via nodemailer) - sends the email verification link on
# signup (see auth/emailVerification.ts, routes/auth.ts's GET
# /auth/verify-email). Works with any SMTP provider; the free option below
# uses your own Gmail account, no new service signup required:
#   1. Turn on 2-Step Verification on your Google account (required for
#      App Passwords): myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" as the app) - copy the 16-character password shown.
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail
#      address, SMTP_PASS=that app password (NOT your normal Gmail password).
# Without all of SMTP_HOST/SMTP_USER/SMTP_PASS set, sendEmail() logs a
# warning and skips sending - signup still succeeds, the account is just
# left unverified. Gmail's free sending limit is ~500/day, fine at this
# app's scale.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Palm Setu

# Public base URL this server is reachable at, used to build the
# verification link above (e.g. https://palmsetu.com). Falls back to
# http://localhost:$PORT for local dev.
PUBLIC_BASE_URL=

# Gemini image-generation model for Soulmate Sketch portraits - uses the
# same GEMINI_API_KEY above. Override only if you need a different
# image-capable model than the default (see ai/geminiImageProvider.ts).
GEMINI_IMAGE_MODEL=

# TEMPORARY TESTING OVERRIDE - set to "true" to let the Tarot Daily Card be
# redrawn on every request instead of once per real calendar day, so the
# reveal flow can be tested repeatedly. Remove/unset this before finishing
# the app - see routes/tarot.ts's TESTING_UNLIMITED_DAILY_REVEALS.
TAROT_UNLIMITED_DAILY_REVEALS=

# Super Admin panel (/admin-panel) - real auth, see auth/adminAuth.ts.
# Set BOTH on first boot only, to provision the one and only initial Super
# Admin account (admin_users table). Ignored on every later boot once at
# least one admin_users row exists - safe to leave set or remove afterwards.
# Password must be 12+ characters. There is no other way to create an admin
# account: there is no public admin registration endpoint.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# RevenueCat (https://app.revenuecat.com/) - real Google Play/App Store
# subscription billing. This is the SECRET REST API key (Project Settings >
# API Keys > Secret key), used only server-side to re-verify a purchase
# RevenueCat's client SDK already reported, before ever granting Premium -
# see routes/billing.ts's /confirm-purchase. Without it, that route returns
# a clear BILLING_NOT_CONFIGURED error rather than trusting the client.
# This is NOT the same key as the app's EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY
# (app/.env.example) - that one is the public SDK key, safe to ship in the app.
REVENUECAT_SECRET_API_KEY=

# --- Text AI provider: gemini | anthropic (Claude Haiku 5.5; needs ANTHROPIC_API_KEY). Palm photo analysis always uses Gemini.
# AI_TEXT_PROVIDER=gemini
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Premium AI spend cap (estimates, tune to your real Gemini pricing) ---
# AI_MONTHLY_BUDGET_INR_PREMIUM=40
# Built-in prices per provider (USD per 1M tokens): Gemini 3.5 Flash-Lite 0.30/2.50, Claude Haiku 5.5 0.10/0.50. Override if needed:
# AI_GEMINI_INPUT_USD_PER_MTOK=
# AI_GEMINI_OUTPUT_USD_PER_MTOK=
# AI_ANTHROPIC_INPUT_USD_PER_MTOK=
# AI_ANTHROPIC_OUTPUT_USD_PER_MTOK=
# AI_USD_INR=88
# AI_OUTPUT_TOKEN_MULTIPLIER=1.5

# --- Backups (SQLite snapshot + palm photos). Runs at startup and every BACKUP_INTERVAL_HOURS; keeps the newest BACKUP_KEEP.
# Point BACKUP_DIR at a DIFFERENT disk/synced folder for real disaster recovery. Manual run: npm run backup
# BACKUP_DIR=
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
# BACKUP_ENABLED=true

# --- Error alerts: any Slack/Discord-style webhook that accepts a JSON POST. Errors are always logged to data/logs/errors.log.
# ALERT_WEBHOOK_URL=

# --- Guest data retention: guests older than this (and all their data) are deleted by a background job.
# GUEST_RETENTION_DAYS=90
# GUEST_CLEANUP_BATCH=100

# --- Email (verification + password reset). Pick ONE. Gmail SMTP (SMTP_*) caps at ~500/day - fine for testing only.
# Resend (resend.com, free tier): set RESEND_API_KEY and EMAIL_FROM (an address on a domain you verified there)
# Brevo  (brevo.com, free tier):  set BREVO_API_KEY and EMAIL_FROM (a verified sender)
# EMAIL_PROVIDER=resend|brevo|smtp   (optional: auto-detected from which key is set)
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Palm Setu

# Free plan AI chat: messages per day, and total AI spend (INR, all features) per month before chat drops to non-AI answers.
# AI_FREE_CHAT_MONTHLY_MESSAGES=0
# PALM_FREE_SCANS_PER_MONTH=1
# AI_FREE_CHAT_MONTHLY_INR=10

# Google sign-in: comma-separated OAuth client IDs (web, android, ios) this server accepts ID tokens for. Empty = Google sign-in disabled.
GOOGLE_CLIENT_IDS=
# Free accounts: most AI spend (INR, all features) per month, and AI chat messages per network address per day.
# AI_MONTHLY_BUDGET_INR_FREE=25
# AI_FREE_CHAT_DAILY_PER_IP=60
