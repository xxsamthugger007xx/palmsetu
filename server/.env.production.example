# ============================================================================
# Palm Setu backend - PRODUCTION settings. Copy to .env on the server (never commit the real file).
# Lines marked REQUIRED must be set or the app will refuse to start / sign-in will not work.
# ============================================================================

NODE_ENV=production
PORT=4000
# Behind Caddy / a host's load balancer: lets the server see each visitor's real IP (needed for rate limits).
TRUST_PROXY=true

# REQUIRED - the public address of THIS backend, with https. Palm photo links are built from it.
PUBLIC_BASE_URL=https://api.example.com
# Web origins allowed to call the API from a browser (the admin panel is same-origin, so this can stay empty for a phone-only app).
# CORS_ORIGINS=

# REQUIRED - random secret that signs sign-in tokens. Make one with:  openssl rand -hex 32
JWT_SECRET=

# --- First admin (created on first start if no admin exists). Use a long, unique password, then change it in the panel. ---
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# --- AI ---
# Text AI (chat, readings): "anthropic" (Claude Haiku) or "gemini".
AI_TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Palm photo analysis always uses Gemini vision.
GEMINI_API_KEY=
# Monthly AI spend ceilings per user, in rupees.
AI_MONTHLY_BUDGET_INR_PREMIUM=40
AI_MONTHLY_BUDGET_INR_FREE=25
AI_FREE_CHAT_MONTHLY_MESSAGES=0
PALM_FREE_SCANS_PER_MONTH=1
AI_FREE_CHAT_DAILY_PER_IP=60

# --- Bot protection (Cloudflare Turnstile). REQUIRED in production: sign-in is refused without the secret. ---
TURNSTILE_SECRET_KEY=

# --- Google sign-in: comma-separated OAuth client IDs (web, android[, ios]) ---
GOOGLE_CLIENT_IDS=

# --- Email (verification + password reset). Pick ONE provider and fill its keys. ---
EMAIL_PROVIDER=resend
# The sending address must be on a domain you have verified with your email provider.
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Palm Setu
RESEND_API_KEY=
# BREVO_API_KEY=
# or SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= SMTP_FROM=

# --- Payments ---
# RevenueCat secret key (server verifies Google Play purchases through it).
REVENUECAT_SECRET_API_KEY=
# Only if you keep one-time Razorpay purchases (Soulmate Sketch):
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Operations ---
# A Slack/Discord/other webhook that gets pinged when the server hits errors.
ALERT_WEBHOOK_URL=
# Backups run at start and every BACKUP_INTERVAL_HOURS. Point BACKUP_DIR at a DIFFERENT disk or synced folder for real safety.
# BACKUP_DIR=
BACKUP_KEEP=14
# Delete unused guest accounts after this many days.
GUEST_RETENTION_DAYS=90

# --- Must stay UNSET in production (testing shortcuts) ---
# TAROT_UNLIMITED_DAILY_REVEALS
# ALLOW_DEMO_USER_HEADER
